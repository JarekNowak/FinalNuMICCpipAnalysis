# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
*.o
*.d
*.so
*.dylib
*.pcm
*_rdict.pcm

# ---------------------------------------------------------------------------
# Data. xsec_analyzer/Files/ alone is ~12 GB of processed ntuples; ROOT files
# anywhere in the tree are inputs or generated results, never source.
# ---------------------------------------------------------------------------
xsec_analyzer/Files/
*.root

# ---------------------------------------------------------------------------
# Generated results and figures. The macros that produce these ARE tracked;
# the outputs are reproducible from them. Drop these two lines if you would
# rather keep figure history in the repo.
# ---------------------------------------------------------------------------
xsec_analyzer/unfold_output/
*.pdf
*.png

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
*~
*.swp
.DS_Store
.ipynb_checkpoints/

# NOTE: deliberately NOT ignored --
#   *.xml       TMVA weight files under booster_decision_tree/ are needed at
#               runtime by CC1mu1piXp.
#   *.orig      config backups; they carry the only record of some threshold
#   *.p01bak    changes, so they are tracked until you confirm they are stale.

# LaTeX build artifacts (keep .tex and the built .pdf; drop the rest)
*.aux
*.toc
*.out
*.synctex.gz
report/*.log
# Built internal-note PDFs are deliverables — keep them despite the global *.pdf
!report/NuMIInternalNoteCC1pi.pdf
!report/SelectionExtractionProcedure.pdf
# Driver/run logs
logs/

# Generator prediction pipeline: keep code, ignore large generator outputs
generator_predictions/nuwro/*.root
generator_predictions/nuwro/*.root.*
generator_predictions/analysis/nuwro_cc1pi
generator_predictions/**/*.log

# GENIE standalone: keep code, ignore large event/spline files
generator_predictions/genie/*.root
generator_predictions/genie/test_numu_ar
generator_predictions/genie/input-flux.root
generator_predictions/genie/*.status
generator_predictions/genie/*.log

# generator scratch (large intermediate outputs)
*.part
*.root.*
generator_predictions/newg4/g_numu
generator_predictions/**/random_seed
generator_predictions/T.txt
generator_predictions/q0.txt
generator_predictions/q2.txt
generator_predictions/qv.txt
generator_predictions/totals.txt
generator_predictions/newg4/T.txt

# ---------------------------------------------------------------------------
# Generator run artifacts. The event samples, their per-run working directories
# and the NEUT/GiBUU cross-section tables are inputs or intermediates, not
# source: 7.5 GB of them in this tree at the time of writing. The macros and
# driver scripts that consume them ARE tracked, so the chain stays reproducible
# given the samples.
# ---------------------------------------------------------------------------
*.dat
generator_predictions/newg4/gibuu/run_*/
generator_predictions/newg4/*.status

# Scanned or external documents kept alongside the note (3.2 GB)
report/internalDocs/

# GENIE per-run output directory and compiled generator readers (binaries)
generator_predictions/newg4/g_numu
generator_predictions/newg4/g_numubar
generator_predictions/newg4/nuwro_cc1pi
generator_predictions/newg4/nuwro_cc1pi1p
generator_predictions/newg4/neut/fort.*
generator_predictions/ppi2bin/nuwro_cc1pi_2bin
generator_predictions/pmufix/nuwro_cc1pi_pmufix

# TMVA training output (the weights .xml ARE tracked; the rest is regenerable)
xsec_analyzer/golden_nolen/

# TMVA emits a C++ translation of each BDT alongside the weights; it regenerates
# from the .xml, so only the weights are tracked.
golden_*/weights/*.class.C
